# Peek App Store lanes. Credentials come from the environment, never this repo:
#   APP_STORE_CONNECT_KEY_ID, APP_STORE_CONNECT_ISSUER_ID, APP_STORE_CONNECT_KEY_FILEPATH
# The binary is built with Xcode (archive + export) and uploaded with Transporter or `upload`.

default_platform(:mac)

BUNDLE_ID = "com.madebysan.peek"

def api_key
  app_store_connect_api_key(
    key_id: ENV.fetch("APP_STORE_CONNECT_KEY_ID"),
    issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
    key_filepath: File.expand_path(ENV.fetch("APP_STORE_CONNECT_KEY_FILEPATH")),
    in_house: false
  )
end

def peek_app
  api_key
  Spaceship::ConnectAPI::App.find(BUNDLE_ID) || UI.user_error!("No App Store Connect app for #{BUNDLE_ID}")
end

platform :mac do
  before_all do
    ENV["FASTLANE_HIDE_CHANGELOG"] = "1"
    ENV["FASTLANE_SKIP_UPDATE_CHECK"] = "1"
  end

  desc "Show App Store versions and recent builds"
  lane :status do
    app = peek_app
    app.get_app_store_versions(filter: { platform: "MAC_OS" }).first(4).each do |v|
      UI.message("Version #{v.version_string}: #{v.app_store_state} (#{v.release_type})")
    end
    edit = app.get_edit_app_store_version(platform: Spaceship::ConnectAPI::Platform::MAC_OS, includes: "build")
    if edit
      UI.message("Editable version #{edit.version_string}, build: #{edit.build ? edit.build.version : 'none'}")
      edit.get_app_store_version_localizations.each do |loc|
        UI.message("What's New (#{loc.locale}): #{loc.whats_new.to_s.tr("\n", " ")}")
      end
    end
    Spaceship::ConnectAPI::Build.all(app_id: app.id, sort: "-uploadedDate", limit: 5).each do |b|
      UI.message("Build #{b.app_version} (#{b.version}): #{b.processing_state}, uploaded #{b.uploaded_date}")
    end
  end

  desc "Upload the exported pkg. Usage: fastlane mac upload pkg:path/to/Peek.pkg"
  lane :upload do |options|
    upload_to_app_store(
      api_key: api_key,
      pkg: options[:pkg] || ".build/appstore/export/Peek.pkg",
      platform: "osx",
      skip_metadata: true,
      skip_screenshots: true,
      submit_for_review: false,
      run_precheck_before_submit: false
    )
  end

  desc "Create or update a version with What's New and attach its build. Never submits for review."
  desc "Usage: fastlane mac prepare_version version:1.3 build:5"
  lane :prepare_version do |options|
    version_string = options.fetch(:version)
    build_number = options.fetch(:build).to_s
    app = peek_app
    notes = File.read(File.join(__dir__, "release_notes.txt"), encoding: "UTF-8").strip

    version = app.get_edit_app_store_version(platform: Spaceship::ConnectAPI::Platform::MAC_OS)
    if version.nil?
      UI.message("Creating version #{version_string}")
      Spaceship::ConnectAPI.post_app_store_version(app_id: app.id, attributes: {
        platform: Spaceship::ConnectAPI::Platform::MAC_OS, versionString: version_string
      })
      version = app.get_edit_app_store_version(platform: Spaceship::ConnectAPI::Platform::MAC_OS)
    elsif version.version_string != version_string
      UI.message("Renaming editable version #{version.version_string} to #{version_string}")
      version.update(attributes: { version_string: version_string })
    end

    # Manual release: approval does not publish until san releases it
    version.update(attributes: { release_type: "MANUAL" })

    version.get_app_store_version_localizations.each do |loc|
      loc.update(attributes: { whats_new: notes })
      UI.message("What's New set for #{loc.locale}")
    end

    build = Spaceship::ConnectAPI::Build.all(app_id: app.id, version: version_string,
                                            build_number: build_number, platform: "MAC_OS").first
    if build.nil?
      UI.important("Build #{version_string} (#{build_number}) not found yet; rerun once it has processed")
    elsif build.processing_state != "VALID"
      UI.important("Build #{build_number} is #{build.processing_state}; rerun once it is VALID")
    else
      version.select_build(build_id: build.id)
      UI.success("Attached build #{version_string} (#{build_number}) to version #{version_string}")
    end
  end
end
